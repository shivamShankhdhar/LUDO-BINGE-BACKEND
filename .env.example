# Export these variables in your shell/IDE; Spring does not load .env automatically.
PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ludo_binge
SPRING_DATASOURCE_USERNAME=ludo_binge
SPRING_DATASOURCE_PASSWORD=local-development-only
DB_POOL_SIZE=10
DB_POOL_MIN_IDLE=1
# Compose-only local development password (keep it aligned with datasource password).
POSTGRES_PASSWORD=local-development-only
